# Django
SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_LARGA_Y_ALEATORIA
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=America/Managua
ENABLE_HSTS=False

# PostgreSQL en producción. Déjalo vacío para SQLite local.
DATABASE_URL=

# =========================================================
# PAGOS
# =========================================================
# HBL usa únicamente recargas MANUALES.
# Los destinos de pago, instrucciones, mínimos, moneda, TXID y estado activo
# se administran desde HBL Control -> Métodos de pago.
# Toda recarga exige comprobante y queda pendiente hasta aprobación manual.

# Email opcional
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HBL <no-reply@example.com>

# Media local (solo pruebas). En producción usa storage S3-compatible.
SERVE_MEDIA=True

# S3 / Cloudflare R2 / Wasabi / compatible (opcional)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False
