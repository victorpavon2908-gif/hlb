# Django
SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_LARGA_Y_ALEATORIA
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=America/Managua
ENABLE_HSTS=False

# PostgreSQL en producción. Déjalo vacío para SQLite local.
DATABASE_URL=

# =========================================================
# MÉTODOS DE RECARGA: TRC20, BEP20 Y TRANSFERENCIA BANCARIA
# =========================================================
# Direcciones PÚBLICAS receptoras de tu cuenta. Nunca pegues seed phrase,
# private key, contraseña de Binance ni códigos 2FA.
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=

# Transferencia bancaria. También puede configurarse/editarse desde HBL Control.
# Si estas variables están vacías, el deploy conserva los datos bancarios ya
# guardados en la base de datos.
BANK_TRANSFER_DESTINATION=
BANK_TRANSFER_NETWORK=
BANK_TRANSFER_INSTRUCTIONS=

# HBL puede consultar Binance para obtener las direcciones durante el deploy.
# Si ya definiste USDT_TRC20_ADDRESS y USDT_BEP20_ADDRESS, estas credenciales
# son opcionales. Si las usas, crea una API key SIN permiso de retiro.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_BASE_URL=https://api.binance.com

# =========================================================
# VALIDACIÓN AUTOMÁTICA EN BLOCKCHAIN
# =========================================================
# TRON / TRC20. La API key de TronGrid es opcional pero recomendable para
# evitar límites bajos del endpoint público.
TRONGRID_API_URL=https://api.trongrid.io
TRONGRID_API_KEY=
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# BNB Smart Chain / BEP20. Puedes sustituir BSC_RPC_URL por un RPC privado.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
USDT_BEP20_CONTRACT=0x55d398326f99059ff775485246999027b3197955
BSC_REQUIRED_CONFIRMATIONS=12

# Un TXID demasiado anterior al momento en que se registró la recarga no se
# acredita automáticamente; se envía a revisión manual.
CRYPTO_TX_MAX_AGE_MINUTES=30

# Email opcional
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HBL <no-reply@example.com>

# Media local (solo pruebas). En producción usa storage S3-compatible.
SERVE_MEDIA=True

# S3 / Cloudflare R2 / Wasabi / compatible (opcional)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False
