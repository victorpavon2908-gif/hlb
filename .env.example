# Django
SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_LARGA_Y_ALEATORIA
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=America/Managua
ENABLE_HSTS=False

# PostgreSQL en producción. Déjalo vacío para SQLite local.
DATABASE_URL=

# =========================================================
# RECARGAS USDT - SOLO TRC20 Y BEP20
# =========================================================
# Opción recomendada: pega las direcciones PÚBLICAS de depósito USDT de tu
# propia cuenta. Nunca pegues seed phrase, private key ni códigos 2FA.
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=

# Opción automática: HBL puede consultar en Binance la dirección de depósito
# de USDT para TRX y BSC durante el deploy. Estas credenciales son secretos del
# servidor y NO deben subirse al repositorio. Usa una API key sin permisos de retiro.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_BASE_URL=https://api.binance.com

# Email opcional
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HBL <no-reply@example.com>

# Media local (solo pruebas). En producción usa storage S3-compatible.
SERVE_MEDIA=True

# S3 / Cloudflare R2 / Wasabi / compatible (opcional)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False
